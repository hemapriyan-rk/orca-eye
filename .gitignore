# ORCA EYE — .gitignore
# ========================

# Runtime outputs (large, session-specific)
logs/
failure_cases/
scratch/
data/scenarios/*.mp4
data/scenarios/*.avi

# Model weights (downloaded automatically by ultralytics / torch.hub)
*.pt
*.pth
*.onnx

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
env/
.venv/
.env/

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Torch hub cache (large)
# Note: don't gitignore hub cache globally — it may be on a separate drive
